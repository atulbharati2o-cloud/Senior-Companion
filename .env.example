# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (matches docker-compose.yml)
POSTGRES_USER=companion
POSTGRES_PASSWORD=companion_secret
POSTGRES_DB=senior_companion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://companion:companion_secret@localhost:5432/senior_companion

# Redis (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# RabbitMQ (matches docker-compose.yml)
RABBITMQ_DEFAULT_USER=companion
RABBITMQ_DEFAULT_PASS=companion_secret
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_URL=amqp://companion:companion_secret@localhost:5673

# JWT Secret for authentication
JWT_SECRET=super_secret_jwt_key_for_development_change_in_production

# LLM API configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
